# ──────────────────────────────────────────────────────────
# Tu Playa Limpia — Variables de entorno
# INSTRUCCIONES: Copia este archivo como ".env" y completa
# los valores. El archivo .env NUNCA se sube a GitHub.
# ──────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────
APP_NAME="Tu Playa Limpia"
APP_VERSION="1.0.1"

# ── Vercel (token efímero — se renueva automáticamente) ────
VERCEL_OIDC_TOKEN=

# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxxxx.mongodb.net/

# ── Backend principal (Node/Express/MongoDB) ───────────────
# Local:      http://localhost:8000
# Producción: https://tuplayalimpia-backend.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Roboflow — Workflow "Beach debris v1 Logic" ────────────
# Obtén tu API key en: https://app.roboflow.com/settings/api
EXPO_PUBLIC_ROBOFLOW_API_KEY=your_api_key_here
EXPO_PUBLIC_ROBOFLOW_WORKSPACE=chakaloca000-gmail-com
EXPO_PUBLIC_ROBOFLOW_WORKFLOW=beach-debris-v1-logic
EXPO_PUBLIC_ROBOFLOW_MODEL=beach-debris-subok/1

# ── API de IA Propia (modelo YOLOv8 local) ─────────────────
# Corre "python api_ia.py" y pon aquí la URL del servidor.
# Local (misma red WiFi): http://TU_IP_LOCAL:5000
EXPO_PUBLIC_AI_API_URL=

# "true"  → usa el modelo YOLOv8 propio (api_ia.py)
# "false" → usa Roboflow Workflow como backend de IA  ← valor recomendado
EXPO_PUBLIC_USE_OWN_AI=false

# ── Backend (sin prefijo EXPO_PUBLIC — solo servidor) ──────
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL=od-tpl/1
ROBOFLOW_WORKSPACE=giovannis-workspace-yghlu
ROBOFLOW_WORKFLOW=beach-debris-v1-logic

# ── Blockchain / ZKsync ────────────────────────────────────
# (si aplica)
# PRIVATE_KEY=
# ZKSYNC_RPC_URL=
