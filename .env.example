# ──────────────────────────────────────────────────────────
# Tu Playa Limpia — Variables de entorno
# INSTRUCCIONES: Copia este archivo como ".env" y completa
# los valores. El archivo .env NUNCA se sube a GitHub.
# ──────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────
APP_NAME="Tu Playa Limpia"
APP_VERSION="1.0.1"

# ── Backend principal (Node/Express/MongoDB) ───────────────
# Local:      http://localhost:8000
# Producción: https://tuplayalimpia-backend.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Roboflow (fallback de IA — opcional si usas modelo propio) ──
# Para modelos directos: solo ROBOFLOW_MODEL
EXPO_PUBLIC_ROBOFLOW_API_KEY=
EXPO_PUBLIC_ROBOFLOW_MODEL=ocean-waste/2

# Para workflows de Roboflow: usa workspace y workflow
EXPO_PUBLIC_ROBOFLOW_WORKSPACE=
EXPO_PUBLIC_ROBOFLOW_WORKFLOW=

# ── API de IA Propia (modelo YOLOv8 de clasificación de residuos) ──
# Corre "python api_ia.py" y pon aquí la URL del servidor.
# Local (misma red WiFi): http://TU_IP_LOCAL:5000
#   - Windows: ejecuta "ipconfig" y busca tu IPv4
#   - Mac/Linux: ejecuta "ifconfig" y busca tu IP
# Producción: https://tu-servicio.railway.app
EXPO_PUBLIC_AI_API_URL=

# "true"  → usa el modelo YOLOv8 propio (api_ia.py)
# "false" → usa Roboflow como backend de IA
EXPO_PUBLIC_USE_OWN_AI=true

# ── Blockchain / ZKsync ────────────────────────────────────
# (si aplica)
# PRIVATE_KEY=
# ZKSYNC_RPC_URL=
